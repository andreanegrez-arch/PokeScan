# Copy this file to .env.local and adjust the values.

# Where the app calls the API. Leave it unset during development: the app then
# calls /api and Vite forwards it to the backend at http://localhost:8000,
# which also works from a phone on the same Wi-Fi (`npm run dev:lan`).
# Set it only to call an API running somewhere else.
# VITE_API_URL=https://api.example.com
