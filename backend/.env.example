# Copy this file to .env and adjust the values.

# PostgreSQL connection, without the password.
# Local install: the "postgres" user created by the installer.
# Docker (docker-compose.yml): postgresql://pokescan@localhost:5432/pokescan
DATABASE_URL=postgresql://postgres@localhost:5432/pokescan

# Password of that user. Use quotes if it contains spaces or #.
# Docker: pokescan
DATABASE_PASSWORD=

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Development: keep every scanned photo, with its result, in a folder of its
# own here (inside backend/), to study real phone photos. Off when unset.
# SCAN_ARCHIVE_DIR=.cache/scans
